; Engine configuration file.
; Zombie Hockey League — Godot 4, Windows (Steam) target.
; Locked identity: one arcade league match. No manager sim, no tower defence.

config_version=5

[application]

config/name="Zombie Hockey League"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")

[display]

